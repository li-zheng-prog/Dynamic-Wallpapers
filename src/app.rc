// 应用资源：图标 + 标题栏标记 + 版本信息
// 改图标：替换项目根目录的 logo.png（正方形、建议 512 以上），重新运行 build/build.sh；
// 脚本用 build/make_icon.py 生成 app.ico（exe/托盘/窗口/安装程序共用）
// 和 logo_ui.png（下面这条 RCDATA，主界面标题栏左上角的小标记）
#include "resource.h"
#include <winver.h>

IDI_APPICON     ICON    "app.ico"
IDR_LOGO_PNG    RCDATA  "logo_ui.png"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION     1,0,0,0
 PRODUCTVERSION  1,0,0,0
 FILEFLAGSMASK   0x3fL
 FILEFLAGS       0x0L
 FILEOS          VOS_NT_WINDOWS32
 FILETYPE        VFT_APP
 FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "080404B0"
        BEGIN
            VALUE "CompanyName",      "Dynamic Wallpapers"
            VALUE "FileDescription",  "Dynamic Wallpapers"
            VALUE "FileVersion",      "1.0.0.0"
            VALUE "InternalName",     "DynamicWallpapers"
            VALUE "OriginalFilename", "DynamicWallpapers.exe"
            VALUE "ProductName",      "Dynamic Wallpapers"
            VALUE "ProductVersion",   "1.0.0.0"
            VALUE "LegalCopyright",   "MIT License"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x804, 1200
    END
END
